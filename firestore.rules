rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return signedIn() &&
        userData().rol == "admin" &&
        userData().activo == true;
    }

    function isActiveCustomer() {
      return signedIn() &&
        userData().rol == "cliente" &&
        userData().activo == true;
    }

    match /usuarios/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          "nombre",
          "email",
          "rol",
          "activo",
          "proveedor",
          "creadoEn"
        ]) &&
        request.resource.data.rol == "cliente" &&
        request.resource.data.activo == true &&
        request.resource.data.email == request.auth.token.email;

      allow update: if isAdmin() ||
        (signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "nombre",
            "telefono",
            "direccion",
            "fechaNacimiento",
            "genero",
            "fotoPerfil",
            "actualizadoEn"
          ]));

      allow delete: if isAdmin();
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.cliente.uid == request.auth.uid);

      allow create: if isActiveCustomer() &&
        request.resource.data.keys().hasOnly([
          "numero",
          "cliente",
          "entrega",
          "notas",
          "items",
          "cantidadProductos",
          "subtotal",
          "total",
          "estado",
          "creadoEn"
        ]) &&
        request.resource.data.keys().hasAll([
          "numero",
          "cliente",
          "entrega",
          "notas",
          "items",
          "cantidadProductos",
          "subtotal",
          "total",
          "estado",
          "creadoEn"
        ]) &&
        request.resource.data.numero == pedidoId &&
        request.resource.data.cliente is map &&
        request.resource.data.cliente.keys().hasOnly([
          "uid",
          "nombre",
          "email",
          "telefono"
        ]) &&
        request.resource.data.cliente.uid == request.auth.uid &&
        request.resource.data.cliente.nombre is string &&
        request.resource.data.cliente.nombre.size() > 0 &&
        request.resource.data.cliente.nombre.size() <= 120 &&
        request.resource.data.cliente.telefono is string &&
        request.resource.data.cliente.telefono.size() > 0 &&
        request.resource.data.cliente.telefono.size() <= 40 &&
        request.resource.data.entrega is map &&
        request.resource.data.entrega.keys().hasOnly(["tipo", "direccion"]) &&
        request.resource.data.entrega.tipo in ["retiro", "envio"] &&
        request.resource.data.entrega.direccion is string &&
        request.resource.data.entrega.direccion.size() <= 300 &&
        (request.resource.data.entrega.tipo != "envio" ||
          request.resource.data.entrega.direccion.size() > 0) &&
        request.resource.data.notas is string &&
        request.resource.data.notas.size() <= 500 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        request.resource.data.cantidadProductos is number &&
        request.resource.data.cantidadProductos > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.subtotal == request.resource.data.total &&
        request.resource.data.estado == "pendiente";

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado",
          "actualizadoEn",
          "items",
          "cantidadProductos",
          "subtotal",
          "total"
        ]) &&
        (
          (resource.data.estado == "pendiente" &&
            request.resource.data.estado in ["confirmado", "cancelado"]) ||
          (resource.data.estado == "confirmado" &&
            request.resource.data.estado in ["completado", "cancelado"])
        );

      allow delete: if isAdmin();
    }

    match /ventas/{ventaId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /configuracion/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
